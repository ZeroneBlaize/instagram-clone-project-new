# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication (set a long random secret in production)
JWT_SECRET=replace-with-strong-32-plus-char-random-secret
JWT_EXPIRES_IN=7d

# Database Mode:
# Leave MONGODB_URI empty to use the zero-config embedded Node.js SQLite store (server/data/framenew.db).
# Set MONGODB_URI to run in full MongoDB + Mongoose (MERN) mode (e.g. via docker-compose.yml).
MONGODB_URI=

# Optional 2026 AI Caption & Alt-Text Assistant via OpenRouter (falls back to deterministic safe engine if empty)
OPENROUTER_API_KEY=
